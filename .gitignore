# Generated from AIS_Recordings/ by tools/make_ais_log.ps1 -- a build artifact,
# not a source: it is ~310 KB duplicating bytes the captures already hold.
# Regenerate after adding or changing a recording:
#     pwsh tools/make_ais_log.ps1
# The sketch builds without it; playback is simply unavailable.
ais_log.h

